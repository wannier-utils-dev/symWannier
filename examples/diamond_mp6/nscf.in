&control
  calculation='nscf', prefix='diamond_mp6', outdir='./work', pseudo_dir='./'
/
&system
  ibrav=0, nat=2, ntyp=1, ecutwfc=30.0, nbnd=4
/
&electrons
  conv_thr=1.0d-9
/
